# ── VESSEL PROTOCOL — Railway Environment Variables ────────────────────────────
# Set all of these in Railway dashboard → Service → Variables

# Database (Railway auto-provisions this — just use ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Server
PORT=8080
NODE_ENV=production
SERVE_STATIC=true
STATIC_DIR=/app/artifacts/btc-experiment/dist/public

# CORS — set to your Railway public URL once deployed
ALLOWED_ORIGINS=https://your-app.railway.app,https://vesselprotocol.xyz

# The URL your frontend uses to reach the API (same service = same domain)
APP_URL=https://your-app.railway.app

# Privy Auth
PRIVY_APP_ID=cmmxtcrow01pm0djul88162l1
PRIVY_APP_SECRET=your-privy-app-secret

# AI (Chutes.ai — OpenAI-compatible)
CHUTES_API_KEY=your-chutes-api-key

# CDP (Coinbase wallets)
CDP_KEY_ID=your-cdp-key-id
CDP_API_KEY=your-cdp-api-key
CDP_WALLET_SECRET=your-cdp-wallet-secret

# Composio (social posting)
COMPOSIO_API_KEY=your-composio-api-key

# AgentMail
AGENTMAIL_API_KEY=your-agentmail-api-key

# Telegram (sports tips + ops alerts)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHANNEL_ID=your-channel-id

# Vessel Protocol specific
VESSEL_WEBHOOK_SECRET=generate-random-32-char-string
INTERNAL_SECRET=generate-random-32-char-string

# Optional: Stripe for paid seats
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
