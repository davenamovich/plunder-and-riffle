modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Moltis: AI Gateway"

[[workflows.workflow]]
name = "Moltis: AI Gateway"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export PATH=\"$PATH:$HOME/.local/bin\"; export OPENAI_API_KEY=$CHUTES_API_KEY; moltis gateway --no-tls --port 13131"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
VITE_PRIVY_APP_ID = "cmmu54ilp045n0dk4c1h0nvpv"
CHUTES_BASE_URL = "https://llm.chutes.ai/v1"
CHUTES_MODEL = "chutesai/Mistral-Small-3.2-24B-Instruct-2506"

[nix]
channel = "stable-25_05"
packages = ["libgcc"]
