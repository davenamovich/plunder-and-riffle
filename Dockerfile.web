FROM node:22-alpine AS builder

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app
COPY . .

RUN pnpm install --frozen-lockfile
RUN cd artifacts/btc-experiment && pnpm build

# Production stage — just serve the static files
FROM node:22-alpine
RUN npm install -g serve
WORKDIR /app
COPY --from=builder /app/artifacts/btc-experiment/dist/public ./public

EXPOSE 3000
ENV PORT=3000
CMD ["serve", "public", "-p", "3000", "-s"]
